<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Cohort</RootNamespace>
        <PackageId>Cohort</PackageId>
        <Version>0.7.3</Version>
        <Authors>Max Anstey</Authors>
        <Description>Annotation-driven GDPR retention for EF Core. Purge, soft-delete, or anonymise rows past their retention period.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/maxanstey-meridian/cohort</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maxanstey-meridian/cohort</RepositoryUrl>
        <PackageTags>dotnet;efcore;gdpr;data-retention;postgresql</PackageTags>
        <IsPackable>true</IsPackable>
        <!-- Public API drift (RS0016 undeclared, RS0017 removed) fails the build. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cronos" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <!-- Already a transitive dependency of every supported host (Cohort requires the Npgsql
             EF Core provider); referenced directly for NpgsqlConnection.ClearPool, the only way
             to keep a session that may still hold an advisory lock out of the pool. -->
        <PackageReference Include="Npgsql" />
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cohort.Tests" />
        <InternalsVisibleTo Include="Cohort.Sample.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
